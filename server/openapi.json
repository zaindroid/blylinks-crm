{
  "openapi": "3.0.0",
  "info": { "title": "Blylinks CRM API", "version": "1.0.0" },
  "paths": {
    "/api/auth/login": { "post": { "summary": "Log in", "responses": { "200": { "description": "OK" } } } },
    "/api/auth/register": { "post": { "summary": "Register a new agent", "responses": { "201": { "description": "Created" } } } },
    "/api/users": { "get": { "summary": "List users", "responses": { "200": { "description": "OK" } } } },
    "/api/campaigns": {
      "get": { "summary": "List campaigns", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Create campaign (Admin)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/campaigns/{id}": { "patch": { "summary": "Update campaign (Admin)", "responses": { "200": { "description": "OK" } } } },
    "/api/campaigns/{id}/toggle-status": { "patch": { "summary": "Toggle campaign active status (Admin)", "responses": { "200": { "description": "OK" } } } },
    "/api/sales": {
      "get": { "summary": "List sales", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Submit a sale (Agent)", "responses": { "201": { "description": "Created" } } }
