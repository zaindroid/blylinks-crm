    "/api/sales/{id}/reject": { "patch": { "summary": "Reject sale (Admin/Supervisor)", "responses": { "200": { "description": "OK" } } } },
    "/api/attendance": { "get": { "summary": "List attendance logs", "responses": { "200": { "description": "OK" } } } },
